@model InstructorViewModel
@{
	ViewData["Title"] = "Instructor Details";
}

<div class="container">
	<div class="row justify-content-center">
		<div class="col-md-8">
			<div class="card shadow">
				<div class="card-header bg-primary text-white">
					<h3 class="card-title mb-0">@Model.FullName</h3>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="col-md-4 text-center">
							@if (!string.IsNullOrEmpty(Model.Image))
							{
								<img src="@Model.Image" alt="@Model.FullName" class="img-fluid rounded mb-3" style="max-height: 200px;" />
							}
							else
							{
								<img src="/images/default-instructor.jpg" alt="Default" class="img-fluid rounded mb-3" style="max-height: 200px;" />
							}
							<p class="text-muted">Hired on: @Model.HiringDate.ToShortDateString()</p>
						</div>
						<div class="col-md-8">
							<h4>Courses</h4>
							@if (Model.CoursesNames != null && Model.CoursesNames.Any())
							{
								<ul class="list-group">
									@foreach (var course in Model.CoursesNames)
									{
										<li class="list-group-item">@course</li>
									}
								</ul>
							}
							else
							{
								<p class="text-muted">This instructor is not teaching any courses.</p>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

